<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingTop="0dp"
    tools:context=".MainActivity">

    <ToggleButton
        style="@style/Widget.BelkaRx.RoundButton"
        android:id="@+id/toggleControlsButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="24dp"
        android:textOn="▲"
        android:textOff="▲"
        android:checked="false"
        android:textSize="14sp"
                app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/topBarCenterContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:gravity="center_vertical"
        app:layout_constraintBottom_toBottomOf="@+id/toggleControlsButton"
        app:layout_constraintEnd_toStartOf="@+id/startStopButton"
        app:layout_constraintStart_toEndOf="@+id/toggleControlsButton"
        app:layout_constraintTop_toTopOf="@+id/toggleControlsButton" />

    <ToggleButton
        style="@style/Widget.BelkaRx.StartStop"
        android:id="@+id/startStopButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="16dp"
        android:textOn="Stop"
        android:textOff="Start"
        android:checked="false"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/controlsContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="12dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toggleControlsButton">

        <TextView
            android:id="@+id/statusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="0dp"
            android:text="Status: Idle"
            android:textSize="12sp"
            android:textColor="@android:color/holo_blue_dark" />

        <LinearLayout
            android:id="@+id/dropdownDynamicArea"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <LinearLayout
            android:id="@+id/mainToggleContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:gravity="center_vertical">

            <ToggleButton
                style="@style/Widget.BelkaRx.Toggle"
                android:id="@+id/swapIQToggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="false"
                android:drawableStart="@drawable/ic_toggle_swap_iq"
                android:textOff="Swap I/Q"
                android:textOn="Swap I/Q" />

            <ToggleButton
                style="@style/Widget.BelkaRx.Toggle"
                android:id="@+id/zoomToggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:checked="false"
                android:contentDescription="Zoom"
                android:drawableStart="@drawable/ic_toggle_zoom"
                android:minWidth="48dp"
                android:textOff="Zoom"
                android:textOn="Zoom" />

            <ToggleButton
                style="@style/Widget.BelkaRx.Toggle"
                android:id="@+id/showSpectrumToggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:checked="false"
                android:contentDescription="Spectrum"
                android:drawableStart="@drawable/ic_toggle_spectrum"
                android:minWidth="48dp"
                android:textOff="Spectrum"
                android:textOn="Spectrum" />

            <ToggleButton
                style="@style/Widget.BelkaRx.Toggle"
                android:id="@+id/markerToggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:checked="false"
                android:minWidth="48dp"
                android:textOff="Marker"
                android:textOn="Marker" />

            <Button
                style="@style/Widget.BelkaRx.ModeButton"
                android:id="@+id/demodModeButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:minWidth="56dp"
                android:text="AM" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/spectrumOptionsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:gravity="center_vertical">

            <ToggleButton
                style="@style/Widget.BelkaRx.Toggle"
                android:id="@+id/spectrumFilledToggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="false"
                android:contentDescription="Filled spectrum"
                android:drawableStart="@drawable/ic_toggle_filled"
                android:minWidth="48dp"
                android:textOff="Fill"
                android:textOn="Fill" />

            <ToggleButton
                style="@style/Widget.BelkaRx.Toggle"
                android:id="@+id/spectrumConstantColorToggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:checked="false"
                android:contentDescription="Monochrome spectrum"
                android:drawableStart="@drawable/ic_toggle_monochrome"
                android:minWidth="48dp"
                android:textOff="Mono"
                android:textOn="Mono" />

            <ToggleButton
                style="@style/Widget.BelkaRx.Toggle"
                android:id="@+id/cwToggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:checked="false"
                android:contentDescription="CW decoder"
                android:minWidth="48dp"
                android:textOff="CW"
                android:textOn="CW" />

            <ToggleButton
                style="@style/Widget.BelkaRx.Toggle"
                android:id="@+id/rttyToggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:checked="false"
                android:contentDescription="RTTY decoder"
                android:minWidth="48dp"
                android:textOff="RTTY"
                android:textOn="RTTY" />

        </LinearLayout>

    </LinearLayout>

    <SurfaceView
        android:id="@+id/waterfallSurface"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/controlsContainer" />

    <!-- CW decoder output, drawn over the bottom of the waterfall (oldest history). -->
    <LinearLayout
        android:id="@+id/cwPanel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="#CC000000"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="6dp"
        android:paddingEnd="8dp"
        android:paddingBottom="6dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Signal level over time; drag to set the squelch threshold. Height set from code. -->
        <hu.ha8mz.belkarx.CwScopeView
            android:id="@+id/cwScope"
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:layout_marginBottom="6dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:minWidth="56dp"
                android:orientation="vertical">

                <View
                    android:id="@+id/cwKeyIndicator"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:background="@drawable/bg_cw_key_indicator" />

                <TextView
                    android:id="@+id/cwWpmText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="monospace"
                    android:text="-- WPM"
                    android:textColor="#B3FFFFFF"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Scrollable text; height (3 lines portrait, 2 landscape) set from code.
                 Follows the newest text unless scrolled up. -->
            <ScrollView
                android:id="@+id/cwTextScroll"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:fadeScrollbars="true"
                android:overScrollMode="never"
                android:scrollbars="vertical">

                <TextView
                    android:id="@+id/cwText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:textColor="@android:color/white"
                    android:textSize="16sp" />
            </ScrollView>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:orientation="vertical">

                <Button
                    style="@style/Widget.BelkaRx.ModeButton"
                    android:id="@+id/cwClearButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minWidth="0dp"
                    android:minHeight="36dp"
                    android:text="Clear" />

                <Button
                    style="@style/Widget.BelkaRx.ModeButton"
                    android:id="@+id/cwSaveButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:minWidth="0dp"
                    android:minHeight="36dp"
                    android:text="Save" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- RTTY decoder output, drawn over the bottom of the waterfall like the CW strip:
         tuning scope and settings on top, decoded text below. -->
    <LinearLayout
        android:id="@+id/rttyPanel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="#CC000000"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="6dp"
        android:paddingEnd="8dp"
        android:paddingBottom="6dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Crossed-ellipse tuning scope; always square, height set from code. -->
            <hu.ha8mz.belkarx.RttyScopeView
                android:id="@+id/rttyScope"
                android:layout_width="wrap_content"
                android:layout_height="140dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <!-- Each group: caption + choices. Caption above in portrait, beside in landscape. -->
                <LinearLayout
                    android:id="@+id/rttyBaudGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/rttyBaudCaption"
                        style="@style/Widget.BelkaRx.Caption"
                        android:text="Baud" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="32dp"
                        android:orientation="horizontal">

                        <!-- Baud rate choices, filled in from code. -->
                        <LinearLayout
                            android:id="@+id/rttyBaudRow"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:orientation="horizontal" />

                        <ToggleButton
                            style="@style/Widget.BelkaRx.Toggle"
                            android:id="@+id/rttyInvertToggle"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:layout_marginStart="8dp"
                            android:checked="false"
                            android:contentDescription="Invert mark and space"
                            android:minHeight="32dp"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:textSize="13sp"
                            android:textOff="Invert"
                            android:textOn="Invert" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/rttyShiftGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/rttyShiftCaption"
                        style="@style/Widget.BelkaRx.Caption"
                        android:text="Shift (Hz)" />

                    <!-- Shift choices, filled in from code. -->
                    <LinearLayout
                        android:id="@+id/rttyShiftRow"
                        android:layout_width="match_parent"
                        android:layout_height="32dp"
                        android:orientation="horizontal" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:minWidth="56dp"
                android:orientation="vertical">

                <View
                    android:id="@+id/rttySignalIndicator"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:background="@drawable/bg_cw_key_indicator" />

                <TextView
                    android:id="@+id/rttySnrText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="monospace"
                    android:text="-- dB"
                    android:textColor="#B3FFFFFF"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Scrollable text; height (6 lines portrait, 2 landscape) set from code.
                 Follows the newest text unless scrolled up. -->
            <ScrollView
                android:id="@+id/rttyTextScroll"
                android:layout_width="0dp"
                android:layout_height="96dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:fadeScrollbars="true"
                android:overScrollMode="never"
                android:scrollbars="vertical">

                <TextView
                    android:id="@+id/rttyText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:textColor="@android:color/white"
                    android:textSize="16sp" />
            </ScrollView>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:orientation="vertical">

                <Button
                    style="@style/Widget.BelkaRx.ModeButton"
                    android:id="@+id/rttyClearButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minWidth="0dp"
                    android:minHeight="36dp"
                    android:text="Clear" />

                <Button
                    style="@style/Widget.BelkaRx.ModeButton"
                    android:id="@+id/rttySaveButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:minWidth="0dp"
                    android:minHeight="36dp"
                    android:text="Save" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Views to be moved dynamically -->
    <LinearLayout
        android:id="@+id/spinnerContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        tools:ignore="MissingConstraints">

        <!-- No input device selector: capture always uses the input Android routes to. -->
        <!-- Waterfall color scales: one gradient swatch per scale, filled in from code. -->
        <LinearLayout
            android:id="@+id/colorScaleRow"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/sensitivityView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        tools:ignore="MissingConstraints">
        <TextView
            android:id="@+id/sensitivityLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="0dp"
            android:layout_marginBottom="2dp"
            android:text="Sensitivity"
            android:textColor="@android:color/white" />
        <com.google.android.material.slider.Slider
            style="@style/Widget.BelkaRx.Slider"
            android:id="@+id/sensitivitySeekBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_marginStart="8dp"
            android:contentDescription="Sensitivity"
            android:valueFrom="0"
            android:valueTo="130"
            android:value="75"
            android:stepSize="1" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/contrastView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        tools:ignore="MissingConstraints">
        <TextView
            android:id="@+id/contrastLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="0dp"
            android:layout_marginBottom="2dp"
            android:text="Contrast"
            android:textColor="@android:color/white" />
        <com.google.android.material.slider.Slider
            style="@style/Widget.BelkaRx.Slider"
            android:id="@+id/contrastSeekBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_marginStart="8dp"
            android:contentDescription="Contrast"
            android:valueFrom="0"
            android:valueTo="300"
            android:value="100"
            android:stepSize="1" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>