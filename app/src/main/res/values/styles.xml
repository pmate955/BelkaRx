<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Rounded on/off button (Swap I/Q, Zoom, Spectrum, Marker, Fill, Mono). -->
    <style name="Widget.BelkaRx.Toggle" parent="">
        <item name="android:background">@drawable/bg_toggle</item>
        <item name="android:textColor">@color/toggle_text</item>
        <item name="android:drawableTint">@color/toggle_text</item>
        <item name="android:drawablePadding">4dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">14sp</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:gravity">center</item>
        <item name="android:maxLines">1</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="Widget.BelkaRx.StartStop" parent="Widget.BelkaRx.Toggle">
        <item name="android:background">@drawable/bg_start_stop</item>
        <item name="android:textColor">?attr/colorOnPrimary</item>
        <item name="android:minWidth">88dp</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
    </style>

    <style name="Widget.BelkaRx.RoundButton" parent="Widget.BelkaRx.Toggle">
        <item name="android:background">@drawable/bg_round_button</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:paddingStart">0dp</item>
        <item name="android:paddingEnd">0dp</item>
    </style>

    <!-- Demodulation mode (AM / USB / LSB): outlined pill in the accent color. -->
    <style name="Widget.BelkaRx.ModeButton" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="cornerRadius">100dp</item>
        <item name="android:maxLines">1</item>
        <item name="strokeColor">?attr/colorPrimary</item>
        <item name="strokeWidth">1dp</item>
        <item name="rippleColor">#33BB86FC</item>
    </style>

    <!-- Small caption above (or beside) a group of decoder settings. -->
    <style name="Widget.BelkaRx.Caption" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#B3FFFFFF</item>
        <item name="android:textSize">11sp</item>
    </style>

    <!-- Flat, thicker slider without the dense tick marks. -->
    <style name="Widget.BelkaRx.Slider" parent="Widget.MaterialComponents.Slider">
        <item name="trackHeight">8dp</item>
        <item name="thumbRadius">10dp</item>
        <item name="haloRadius">20dp</item>
        <item name="thumbElevation">0dp</item>
        <item name="tickVisible">false</item>
        <item name="thumbColor">?attr/colorPrimary</item>
        <item name="trackColorActive">?attr/colorPrimary</item>
        <item name="trackColorInactive">#33FFFFFF</item>
        <item name="haloColor">#33BB86FC</item>
    </style>
</resources>
