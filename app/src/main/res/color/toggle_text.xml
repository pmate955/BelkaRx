<?xml version="1.0" encoding="utf-8"?>
<!-- Text and icon color of the toggle buttons: dark on the filled (checked) state. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:color="?attr/colorOnPrimary" android:state_checked="true" />
    <item android:alpha="0.38" android:color="@android:color/white" android:state_enabled="false" />
    <item android:color="@android:color/white" />
</selector>
